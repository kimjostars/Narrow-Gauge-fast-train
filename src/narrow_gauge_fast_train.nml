railtypetable {
    TR_1067_NE:       [NAAN, RAIL], //Non-Electrified
    TR_1067_DC:       [NAAD, NAAE, NABE, ELNG, ELRL],
    TR_1067_AC:       [NAAA, NAAE, NABE, ELNG, ELRL],
    TR_1067_ACDC:     [NAAE, NABE, ELNG, ELRL],
    TR_1372_DC:       [sAAD, sAAE, SAAD, SAAE, ELRL],
    TR_1435_NE:       [SAAN, RAIL],
    TR_1435_DC:       [SAAD, ELRL],
    TR_1435_AC:       [SAAA, ELRL],
    TR_1435_ACDC:     [SAAE, ELRL],
    TR_1435_M:        [SAA3, SAB3, "3RDR", MTRO, ELRL],
    TR_1435_LINEAR:   [SAAI, ELRL],
    TR_RUBBER:        [rAA3,rAAE, ELRL],
    TR_UNIVERSAL:     [_AAE,NAAN, RAIL], //for mu cars
}
//template
template tmpl_32_train(x, y) {
    // arguments x, y: coordinates of top-left corner of first sprite
    [x,      y,  8, 24,  -3, -12] //xpos ypos xsize ysize xoff yoff
    [x +  9, y, 22, 20, -14, -12]
    [x + 32, y, 32, 16, -16, -12]
    [x + 65, y, 22, 20,  -6, -12]
}
template tmpl_32_train_4_views(num) {
    // argument num: Index in the graphics file, assuming vertical ordering of vehicles
    tmpl_32_train(1, 1 + 32 * num)
}
template tmpl_32_train_8_views(num, reversed) {
    // argument num: Index in the graphics file, assuming vertical ordering of vehicles
    // argument reversed: Reverse visible orientation of vehicle, if set to 1
    tmpl_32_train(reversed ? 89 : 1, 1 + 32 * num)
    tmpl_32_train(reversed ? 1 : 89, 1 + 32 * num)
}
template tmpl_32_train_single(num, xsize, ysize, xoff, yoff) { 
    [1, 1 + 32 * num, xsize, ysize, xoff, yoff]
}
template tmpl_32_train_basic(x, y){
    //[left_x, upper_y, width, height, offset_x, offset_y]
    [x    , y,  8, 24,  -3, -12]
    [x+9  , y, 22, 20, -14, -12]
    [x+32 , y, 32, 16, -16, -12]
    [x+65 , y, 22, 20,  -6, -12]
    [x+88 , y,  8, 24,  -3, -12]
    [x+97 , y, 22, 20, -14, -12]
    [x+120, y, 32, 16, -16, -12]
    [x+153, y, 22, 20,  -6, -12]
}
template template_purchase_engine(x, y) {
    //[left_x, upper_y, width, height, offset_x, offset_y]
    [x, y,  87, 15, -25, -7]
}
//spriteset,switch
//600_series
spriteset(spriteset_600_series_front_lighted, "src/gfx/600_series.png") { tmpl_32_train_8_views(0, 0) } 
spriteset(spriteset_600_series_rear_lighted, "src/gfx/600_series.png") { tmpl_32_train_8_views(1, 1) } 
spriteset(spriteset_600_series_front, "src/gfx/600_series.png") { tmpl_32_train_8_views(2, 0) } 
spriteset(spriteset_600_series_rear, "src/gfx/600_series.png") { tmpl_32_train_8_views(3, 1) } 
spriteset(spriteset_600_series_middle, "src/gfx/600_series.png") { tmpl_32_train_4_views(4) } 
spriteset(spriteset_600_series_purchase, "src/gfx/600_series.png") { tmpl_32_train_single(5, 53, 14, -25, -10) } 
spriteset(spriteset_600_series_invisible, "src/gfx/600_series.png") { tmpl_32_train_single(6, 1, 1, 0, 0) }

switch(FEAT_TRAINS, SELF, switch_600_series_articulated_part, extra_callback_info1){
    1..8: return item_600_series;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, switch_600_series_attach_wagon, vehicle_type_id){
    item_600_series: return CB_RESULT_ATTACH_ALLOW;
    return string(STR_600_series_CANNOT_ATTACH_OTHER);
}
switch(FEAT_TRAINS, SELF, switch_600_series_graphics, position_in_consist % 9) { 
    0: spriteset_600_series_front_lighted; 
    8: spriteset_600_series_rear_lighted; 
    spriteset_600_series_middle; 
}

//123_serise
spriteset(spriteset_123_series_JW_YY, "src/gfx/123JW.png"){
    tmpl_32_train_basic(0, 0)
}
spriteset(spriteset_123_series_JW_BW, "src/gfx/123JW.png"){
    tmpl_32_train_basic(0, 31)
}
spriteset(spriteset_123_series_purchase, "src/gfx/123JW.png"){
    template_purchase_engine(0, 92)
}
switch(FEAT_TRAINS, SELF, switch_123_serise_cargo_subtype_text, cargo_subtype){
    0: return string(STR_123_SERIES_JW_YY);
    1: return string(STR_123_SERIES_JW_BW);
    return CB_RESULT_NO_TEXT;
}
switch(FEAT_TRAINS, SELF, switch_123_series_graphics, cargo_subtype){
    0: return spriteset_123_series_JW_YY;
    1: return spriteset_123_series_JW_BW;
}
//items
//600series
item(FEAT_TRAINS, item_600_series){
    property {
        name: string(STR_NAME_600_TRAINS);
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date: date(2000,01,01);
        model_life: 45;
        vehicle_life: 30;
        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        loading_speed: 20;
        cost_factor: 50;
        running_cost_factor: 150;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        speed: 201 km/h;
        misc_flags: bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_2CC, TRAIN_FLAG_MU); 
        refit_cost: 0;
        track_type: TR_1067_AC;
        ai_special_flag: AI_FLAG_PASSENGER;
        power: 2000 hp;
        running_cost_base: RUNNING_COST_ELECTRIC;
        dual_headed: 0;
        cargo_capacity: 40;
        weight: 200 ton;
        ai_engine_rank: 0;
        engine_class: ENGINE_CLASS_ELECTRIC;
        extra_power_per_wagon: 0 kW;
        tractive_effort_coefficient: 0.9 / 10;
        air_drag_coefficient: 0.06;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
        extra_weight_per_wagon: 0 ton;
        bitmask_vehicle_info: 0;
    }
    graphics {
        articulated_part: switch_600_series_articulated_part;
        can_attach_wagon: switch_600_series_attach_wagon;
        purchase: spriteset_600_series_purchase;
        default: switch_600_series_graphics;
    }
}
