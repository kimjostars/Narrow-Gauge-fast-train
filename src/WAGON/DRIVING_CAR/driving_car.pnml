#include "driving_car_graphic.pnml"

#include "driving_car_switch.pnml"

item(FEAT_TRAINS, item_driving_car, 9002){
    property {
        name: string(STR_NAME_DRIVENG_CAR);
        climates_available: ALL_CLIMATES;
        introduction_date: date(2020,01,01);
        track_type: TR_1067_NE;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_AUTOREFIT,TRAIN_FLAG_2CC);
        extra_flags: bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);
        refit_cost: 0;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        ai_special_flag: AI_FLAG_PASSENGER;
        ai_engine_rank: 0;
        vehicle_life: 60;
        cost_factor: 80;
        running_cost_factor: 11;
        reliability_decay: 20;
        cargo_capacity: param_cargo_capacity_express;
        loading_speed: param_loading_1D;
        power: 0 kW;
        weight: 28 ton;
        tractive_effort_coefficient: 0;
        air_drag_coefficient: 0.07;
        reliability_decay: 20;
        running_cost_base: RUNNING_COST_STEAM;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        additional_text:
            string(STR_TRAIN_DESC,
            string(STR_NARROWGAUGE),
            string(STR_USAGE, string(STR_DRIVENG_CAR_DESC)),
            string(STR_OPERATOR,string(STR_VIRTUAL,string(STR_JR))),
            string(STR_LIVERIES,string(LV_VARIOUS)));
        speed: param_speed_160_to_200;
        purchase: spriteset_driving_car_purchase;
        default: sw_driving_car_80;
    }
}