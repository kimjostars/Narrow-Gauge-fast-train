item(FEAT_TRAINS, item_mucar, 9000){
    property {
        name: string(STR_MUCAR_NAME);
        climates_available: ALL_CLIMATES;
        introduction_date: date(1800,01,01);
        track_type: [TR_1067_NE,TR_1435_NE];
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_MU,TRAIN_FLAG_AUTOREFIT,TRAIN_FLAG_2CC);
        refit_cost: 0;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        ai_special_flag: AI_FLAG_PASSENGER;
        ai_engine_rank: 0;
        vehicle_life: 60;
        loading_speed: 0;
        cost_factor: 64;
        running_cost_factor: 6;
        reliability_decay: 20;
        speed: 0 km/h;
        power: 0 hp;
        cargo_capacity: 1;
        cargo_age_period: 185;
        weight: 0 ton;
        tractive_effort_coefficient: 0;
        air_drag_coefficient: 0;
        reliability_decay: 20;
        running_cost_base: RUNNING_COST_DIESEL;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        additional_text: string(STR_MU_DESC);
        purchase: spriteset_mucar_purchase;
        default: spriteset_mucar;
    }
}