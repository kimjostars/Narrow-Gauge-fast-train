#include "generater_car_graphic.pnml"

#include "generater_car_switch.pnml"

item(FEAT_TRAINS, item_generater_car){
    property {
        name: string(STR_NAME_GERENATER_CAR_TRAIN);
        climates_available: ALL_CLIMATES;
        introduction_date: date(2020,01,01);
        track_type: TR_1067_NE;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC);
        refit_cost: 0;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        ai_special_flag: AI_FLAG_PASSENGER;
        ai_engine_rank: 0;
        vehicle_life: 60;
        loading_speed: 0;
        cost_factor: 80;
        running_cost_factor: 10;
        reliability_decay: 20;
        speed: param_speed_160_to_200;
        power: 0 kW;
        cargo_capacity: 100;
        cargo_age_period: 185;
        weight: 24 ton;
        tractive_effort_coefficient: 0;
        air_drag_coefficient: 0.07;
        reliability_decay: 20;
        running_cost_base: RUNNING_COST_STEAM;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 4, DISABLE_WAGON_POWER);
        dual_headed: 0;
    }
    graphics {
        additional_text: 
            string(STR_TRAIN_DESC,
            string(STR_NARROWGAUGE),
            string(STR_GENERATER_CAR_DESC),
            string(STR_OPERATOR,string(STR_VIRTUAL,string(STR_JR))));
        cargo_subtype_text: sw_generater_car_cargo_subtype_text;
        purchase: spriteset_generater_car_purchase;
        default: sw_generater_car_graphic;
    }
}