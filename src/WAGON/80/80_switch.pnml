switch(FEAT_TRAINS, SELF, sw_80_series_graphic, cargo_subtype){
    0: return spriteset_80_series_default;
    1: return spriteset_80_series_default_green_car;
    2: return spriteset_80_series_default_garder;
}
switch(FEAT_TRAINS, SELF, sw_80_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH,string(STR_OHA, 80, string(STR_CONCAT_2, string(STR_DEFAULT_LIVERY), string(STR_GENERAL_CAR))));
    1: return string(STR_DASH,string(STR_ORO, 80, string(STR_CONCAT_2, string(STR_DEFAULT_LIVERY), string(STR_GREEN_CAR))));
    2: return string(STR_DASH,string(STR_OHAFU, 80, string(STR_CONCAT_2, string(STR_DEFAULT_LIVERY), string(STR_CONDUCTOR))));
}