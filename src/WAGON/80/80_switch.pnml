switch(FEAT_TRAINS, SELF, sw_80_series_auto_formation_1_to_3, position_in_vehid_chain_from_end){
    0: return spriteset_80_series_default_garder;
    default: return spriteset_80_series_default;
}
switch(FEAT_TRAINS, SELF, sw_80_series_auto_formation_4_to_5, position_in_vehid_chain_from_end){
    0: return spriteset_80_series_default_green_car;
    2: return spriteset_80_series_default_garder;
    default: return spriteset_80_series_default;
}
switch(FEAT_TRAINS, SELF, sw_80_series_auto_formation_6_to_7, position_in_vehid_chain_from_end){
    0..1: return spriteset_80_series_default_green_car;
    3: return spriteset_80_series_default_garder;
    default: return spriteset_80_series_default;
}
switch(FEAT_TRAINS, SELF, sw_80_series_auto_formation_default, position_in_vehid_chain_from_end){
    0..3: return spriteset_80_series_default_green_car;
    4: return spriteset_80_series_default_garder;
    default: return spriteset_80_series_default;
}
switch(FEAT_TRAINS, SELF, sw_80_series_auto_formation, num_vehs_in_vehid_chain){
    1..3: return sw_80_series_auto_formation_1_to_3;
    4..5: return sw_80_series_auto_formation_4_to_5;
    6..7: return sw_80_series_auto_formation_6_to_7;
    default: return sw_80_series_auto_formation_default;
}
switch(FEAT_TRAINS, SELF, sw_80_series_graphic, cargo_subtype){
    1: return spriteset_80_series_default;
    2: return spriteset_80_series_default_green_car;
    3: return spriteset_80_series_default_garder;
    default: sw_80_series_auto_formation;
}
switch(FEAT_TRAINS, SELF, sw_80_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH, string(STR_AUTOFORM));
    1: return string(STR_DASH, string(STR_OHA, 80, string(STR_CONCAT_2, string(STR_DEFAULT_LIVERY), string(STR_GENERAL_CAR))));
    2: return string(STR_DASH, string(STR_ORO, 80, string(STR_CONCAT_2, string(STR_DEFAULT_LIVERY), string(STR_GREEN_CAR))));
    3: return string(STR_DASH, string(STR_OHAFU, 80, string(STR_CONCAT_2, string(STR_DEFAULT_LIVERY), string(STR_CONDUCTOR))));
}