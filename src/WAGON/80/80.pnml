#include "80_graphic.pnml"

#include "80_switch.pnml"

item(FEAT_TRAINS, item_80_series){
    property {
        name: string(STR_NAME_80_SERIES);
        climates_available: ALL_CLIMATES;
        introduction_date: date(2020,01,01);
        track_type: TR_1067_NE;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_AUTOREFIT,TRAIN_FLAG_2CC);
        refit_cost: 0;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        ai_special_flag: AI_FLAG_PASSENGER;
        ai_engine_rank: 0;
        vehicle_life: 60;
        speed: param_speed_160_to_200;
        loading_speed: param_loading_1D;
        cost_factor: 80;
        running_cost_factor: 10;
        reliability_decay: 20;
        power: 0 kW;
        cargo_age_period: 185;
        weight: 28 ton;
        cargo_capacity: param_cargo_capacity_express;
        tractive_effort_coefficient: 0;
        air_drag_coefficient: 0.07;
        reliability_decay: 20;
        running_cost_base: RUNNING_COST_STEAM;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        additional_text:
            string(STR_TRAIN_DESC,
            string(STR_NARROWGAUGE),
            string(STR_USAGE, string(STR_USE_LTDEXPRESS)),
            string(STR_OPERATOR,string(STR_VIRTUAL,string(STR_JR,string(STR_JR_PASSENGER)))));
        cargo_subtype_text: sw_80_series_cargo_subtype_text;
        purchase: spriteset_80_series_purchase;
        default: sw_80_series_graphic;
    }
}