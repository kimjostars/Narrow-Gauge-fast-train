switch(FEAT_TRAINS, SELF, sw_kiha189_series_attach_wagon, [vehicle_type_id == item_kiha189 || vehicle_type_id == item_mucar]){
    0: return string(STR_CANNOT_ATTACH_OTHER);
    1: return CB_RESULT_ATTACH_ALLOW;
}
switch(FEAT_TRAINS, SELF, sw_kiha189_series_front_graphics, train_is_driving_backwards){
    0: return spriteset_kiha189_series_1_front;
    1: return spriteset_kiha189_series_1_back;
}
switch(FEAT_TRAINS, SELF, sw_kiha189_series_back_graphics, train_is_driving_backwards){
    0: return spriteset_kiha189_series_3_front;
    1: return spriteset_kiha189_series_3_back;
}
switch(FEAT_TRAINS, SELF, sw_kiha189_series_graphics, position_in_vehid_chain % 2){ 
    0: return sw_kiha189_series_front_graphics; 
    1: return sw_kiha189_series_back_graphics;
}