#include "N2000_graphic.pnml"

#include "N2000_switch.pnml"

item(FEAT_TRAINS, item_N2000_series, 2001){
    property {
        name: string(STR_NAME_N2000_TRAINS);
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        misc_flags: bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_TILT);
        introduction_date: date(1995,01,01);
        engine_class: ENGINE_CLASS_DIESEL;
        model_life: 45;
        vehicle_life: 30;
        reliability_decay: 10;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        loading_speed: param_loading_2D;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        cost_factor: 21;
        running_cost_factor: 47;
        refit_cost: 0;
        dual_headed: 1;
        track_type: TR_1067_NE;
        weight: 39 ton;
        power: 710 hp;
        cargo_capacity: param_cargo_capacity_express;
        tractive_effort_coefficient: 0.2;
        ai_engine_rank: 0;
        running_cost_base: RUNNING_COST_DIESEL;
        air_drag_coefficient: 0.05;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);
        extra_weight_per_wagon: 0;
        curve_speed_mod: 70;
        bitmask_vehicle_info: 0;
        length: 8;
        variant_group: 2000;
    }
    graphics {
        additional_text:
            string(STR_TRAIN_DESC,
            string(STR_NARROWGAUGE),
            string(STR_NOT_DENKI,string(STR_DIESEL)),
            string(STR_LOAD_SPEED, string(STR_DOORS, 2)),
            string(STR_FORMATION, string(STR_NUM_CARS_RANGE, 2, 4)),
            string(STR_USAGE, string(STR_USE_LTDEXPRESS)),
            string(STR_OPERATOR,string(STR_JR,string(STR_JR_SHIKOKU))));
        can_attach_wagon: sw_2000_series_attach_vehid;
        speed: param_speed_130_to_160;
        start_stop: sw_2000_series_start_stop;
        purchase: spriteset_N2000_series_purchase;
        default: sw_N2000_series_head_graphic;
    }
    livery_override(item_mucar){
        weight: 38;
        curve_speed_mod: 70;
        cargo_capacity: param_cargo_capacity_express;
        loading_speed: param_loading_2D;
        power: 710;
        length: 8;
        default: spriteset_N2000_series_2;
    }
}