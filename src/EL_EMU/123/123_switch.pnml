switch(FEAT_TRAINS, SELF, sw_123_series_JW_YY_graphics, train_is_driving_backwards){
    0: return spriteset_123_series_JW_YY;
    1: return spriteset_123_series_JW_YY_rev;
}
switch(FEAT_TRAINS, SELF, sw_123_series_JW_BW_graphics, train_is_driving_backwards){
    0: return spriteset_123_series_JW_BW;
    1: return spriteset_123_series_JW_BW_rev;
}
switch(FEAT_TRAINS, SELF, sw_123_series_JC_W_2_DOOR_graphics, train_is_driving_backwards){
    0: return spriteset_123_series_JC_W_2_DOOR;
    1: return spriteset_123_series_JC_W_2_DOOR_rev;
}
switch(FEAT_TRAINS, SELF, sw_123_series_JC_W_3_DOOR_graphics, train_is_driving_backwards){
    0: return spriteset_123_series_JC_W_3_DOOR;
    1: return spriteset_123_series_JC_W_3_DOOR_rev;
}
switch(FEAT_TRAINS, SELF, sw_123_series_JE_RW_graphics, train_is_driving_backwards){
    0: return spriteset_123_series_JE_RW;
    1: return spriteset_123_series_JE_RW_rev;
}
switch(FEAT_TRAINS, SELF, sw_123_series_graphics, cargo_subtype){
    0: return sw_123_series_JW_YY_graphics;
    1: return sw_123_series_JW_BW_graphics;
    2: return sw_123_series_JC_W_2_DOOR_graphics;
    3: return sw_123_series_JC_W_3_DOOR_graphics;
    4: return sw_123_series_JE_RW_graphics;
}
switch(FEAT_TRAINS, SELF, sw_123_series_loading_speed, cargo_subtype){
    default: return param_loading_2D; 
    3: return param_loading_3D;
}
switch(FEAT_TRAINS, SELF, sw_123_serise_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH,string(STR_123_SERIES_JW_YY,string(STR_JR,string(STR_JR_WEST))));
    1: return string(STR_DASH,string(STR_123_SERIES_JW_BW,string(STR_JR,string(STR_JR_WEST))));
    2: return string(STR_DASH,string(STR_123_SERIES_JC_W_2_DOOR,string(STR_JR,string(STR_JR_CENTRAL))));
    3: return string(STR_DASH,string(STR_123_SERIES_JC_W_3_DOOR,string(STR_JR,string(STR_JR_CENTRAL))));
    4: return string(STR_DASH,string(STR_123_SERIES_JE_RW,string(STR_JR,string(STR_JR_EAST))));
    return CB_RESULT_NO_TEXT;
}