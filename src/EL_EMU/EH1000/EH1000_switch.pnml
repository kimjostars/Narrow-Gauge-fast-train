switch(FEAT_TRAINS, SELF, sw_EH1000_series_speed, [param_high_speed + cargo_subtype%2]){
    0: return 130;
    1: return 160;
    2: return 199;
}
switch(FEAT_TRAINS, SELF, sw_EF1000_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_EH1000_SERIES_JF_R, string(STR_JR, string(STR_JR_FREIGFT)));
    1: return string(STR_EH1000_SERIES_JF_R_HIGH_SPEED, string(STR_JR, string(STR_JR_FREIGFT)));
    return CB_RESULT_NO_TEXT;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_articulated_part, extra_callback_info1){
    1: return item_EH1000_series;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic, position_in_articulated_veh%2){
    0: return spriteset_EH1000_series_main_1;
    1: return spriteset_EH1000_series_main_2;
}