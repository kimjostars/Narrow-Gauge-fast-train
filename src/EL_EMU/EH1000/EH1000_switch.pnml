switch(FEAT_TRAINS, SELF, sw_EH1000_series_speed, cargo_subtype % 2){
    0: return param_speed_130_to_160;
    1: return param_speed_160_to_200;
}
switch(FEAT_TRAINS, SELF, sw_EF1000_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH, string(STR_CONCAT_4, string(STR_JR, string(STR_JR_FREIGFT)), string(STR_DEFAULT_LIVERY), string(STR_BAR), string(STR_CONCAT_2_DASH_BL, string(STR_RED), string(STR_GRAY))));
    1: return string(STR_DASH, string(STR_CONCAT_5, string(STR_JR, string(STR_JR_FREIGFT)), string(STR_DEFAULT_LIVERY), string(STR_HIGH_SPEED_TYPE,160), string(STR_BAR), string(STR_CONCAT_2_DASH_BL, string(STR_RED), string(STR_GRAY))));
    2: return string(STR_DASH, string(STR_COMPANY));
    3: return string(STR_DASH, string(STR_CONCAT_2, string(STR_COMPANY), string(STR_HIGH_SPEED_TYPE, 160)));
    return CB_RESULT_NO_TEXT;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_default_front_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_default_front;
    1: return spriteset_EH1000_series_default_front_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_default_back_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_default_back;
    1: return spriteset_EH1000_series_default_back_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_2cc_front_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_2cc_front;
    1: return spriteset_EH1000_series_2cc_front_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_2cc_back_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_2cc_back;
    1: return spriteset_EH1000_series_2cc_back_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic_front, cargo_subtype / 2){
    0: return sw_EH1000_series_default_front_graphic;
    1: return sw_EH1000_series_2cc_front_graphic;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic_back, cargo_subtype / 2){
    0: return sw_EH1000_series_default_back_graphic;
    1: return sw_EH1000_series_2cc_back_graphic;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic, position_in_articulated_veh % 2){
    0: return sw_EH1000_series_graphic_front;
    1: return sw_EH1000_series_graphic_back;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_articulated_part, extra_callback_info1){
    1: return item_EH1000_series;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}