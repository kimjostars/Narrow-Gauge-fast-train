#include "521_graphic.pnml"

#include "521_switch.pnml"

item(FEAT_TRAINS, item_521_series, 0521){
    property {
        name: string(STR_NAME_521_TRAINS);
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date: date(2006,10,21);
        model_life: 45;
        vehicle_life: 30;
        reliability_decay: 10;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        loading_speed: param_loading_3D;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        speed: 120 km/h;
        misc_flags: bitmask(TRAIN_FLAG_MU);
        cost_factor: 19;
        running_cost_factor: 45;
        refit_cost: 0;
        track_type: TR_1067_AC_DC;
        ai_special_flag: AI_FLAG_PASSENGER;
        power: 1233 hp;
        running_cost_base: RUNNING_COST_ELECTRIC;
        cargo_capacity: param_cargo_capacity_regional;
        weight: 44 ton;
        ai_engine_rank: 0;
        engine_class: ENGINE_CLASS_ELECTRIC;
        extra_power_per_wagon: 0 kW;
        tractive_effort_coefficient: 0.07;
        air_drag_coefficient: 0.07;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 4, DISABLE_WAGON_POWER);
        extra_weight_per_wagon: 0 ton;
        bitmask_vehicle_info: 0;
        dual_headed: 1;
    }
    graphics {
        additional_text:
            string(STR_TRAIN_DESC,
            string(STR_NARROWGAUGE),
            string(STR_DENKI, string(STR_AC_DC, 20, 60, 1500)),
            string(STR_LOAD_SPEED, string(STR_DOORS, 3)),
            string(STR_FORMATION, string(STR_NUM_CARS_1, 2)),
            string(STR_USAGE, string(STR_USE_GENERAL)),
            string(STR_OPERATOR,string(STR_CONCAT_2_DASH_BL,string(STR_JR,string(STR_JR_WEST)),string(STR_PRIVATE))),
            string(STR_LIVERIES,string(LV_VARIOUS)));
        cargo_subtype_text: sw_521_series_cargo_subtype_text;
        purchase: spriteset_521_series_purchase;
        default: sw_521_series_graphics;
    }
    livery_override(item_mucar){
        weight: 44;
        loading_speed: param_loading_3D;
        cargo_capacity: param_cargo_capacity_regional;
        power: 300;
        default: sw_521_series_graphics;
    }
}