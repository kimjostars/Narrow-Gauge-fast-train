switch(FEAT_TRAINS, SELF, sw_521_1_2_series_graphics, position_in_consist % 2){ 
    0: return spriteset_521_0_series_1_2_0; 
    1: return spriteset_521_0_series_1_2_1; 
}
switch(FEAT_TRAINS, SELF, sw_521_3_series_graphics, position_in_consist % 2){ 
    0: return spriteset_521_0_series_3_0; 
    1: return spriteset_521_0_series_3_1; 
}
switch(FEAT_TRAINS, SELF, sw_521_100_series_graphics_0, train_is_driving_backwards){
    0: return spriteset_521_100_series_0;
    1: return spriteset_521_100_series_0_rev;
}
switch(FEAT_TRAINS, SELF, sw_521_100_series_graphics_1, train_is_driving_backwards){
    0: return spriteset_521_100_series_1;
    1: return spriteset_521_100_series_1_rev;
}
switch(FEAT_TRAINS, SELF, sw_521_100_series_graphics, position_in_consist % 2){ 
    0: return sw_521_100_series_graphics_0; 
    1: return sw_521_100_series_graphics_1; 
}
switch(FEAT_TRAINS, SELF, sw_521_series_graphics, cargo_subtype){
    0: sw_521_1_2_series_graphics;
    1: sw_521_1_2_series_graphics;
    2: sw_521_3_series_graphics;
    3: sw_521_100_series_graphics;
    return CB_RESULT_NO_TEXT;
}
switch(FEAT_TRAINS, SELF, sw_521_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH,string(STR_521_0_SERIES,string(STR_JR,string(STR_JR_WEST))));
    1: return string(STR_521_0_1_2_SERIES);
    2: return string(STR_521_0_3_SERIES);
    3: return string(STR_DASH,string(STR_521_100_SERIES,string(STR_JR,string(STR_JR_WEST))));
}