switch(FEAT_TRAINS, SELF, sw_521_series_graphics, cargo_subtype){
    0: sw_521_1_2_series_graphics;
    1: sw_521_1_2_series_graphics;
    2: sw_521_3_series_graphics;
    3: sw_521_100_series_graphics;
    return CB_RESULT_NO_TEXT;
}
switch(FEAT_TRAINS, SELF, sw_521_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH, string(STR_CONCAT_4, string(STR_JR, string(STR_JR_WEST)), string(STR_CONCAT_SERIES, 0), string(STR_BAR), string(STR_BLUE)));
    1: return string(STR_BRANCH, string(STR_CONCAT_BATCH_STRING, string(STR_COMMA_NUMBER_2, 1, 2)));
    2: return string(STR_END, string(STR_CONCAT_BATCH, 3));
    3: return string(STR_DASH, string(STR_CONCAT_4, string(STR_JR, string(STR_JR_WEST)), string(STR_CONCAT_SERIES, 100), string(STR_BAR), string(STR_CREAM)));
}