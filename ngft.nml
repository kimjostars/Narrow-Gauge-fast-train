spriteset(spriteset_EH1000_series_2cc_back, "gfx/EH1000/EH1000_series_2cc_2.png"){tmpl_32_train_main(0, 1)}
spriteset(spriteset_EH1000_series_2cc_back_rev, "gfx/EH1000/EH1000_series_2cc_2.png"){tmpl_32_train_main(0, 31)}

spriteset(spriteset_EH1000_series_purchase, "gfx/EH1000/EH1000_series_purchase.png"){tmpl_purchase_single_head(0, 0)}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_speed, [param_high_speed + cargo_subtype%2]){
    0: return 130;
    1: return 160;
    2: return 199;
}
switch(FEAT_TRAINS, SELF, sw_EF1000_series_cargo_subtype_text, cargo_subtype){
    0: return string(STR_DASH, string(STR_EH1000_SERIES_JF_R, string(STR_JR, string(STR_JR_FREIGFT)), string(STR_SPACE)));
    1: return string(STR_DASH, string(STR_EH1000_SERIES_JF_R, string(STR_JR, string(STR_JR_FREIGFT)),string(STR_HIGH_SPEED_TYPE,160)));
    2: return string(STR_DASH, string(STR_COMPANY, string(STR_SPACE)));
    3: return string(STR_DASH, string(STR_COMPANY, string(STR_HIGH_SPEED_TYPE,160)));
    return CB_RESULT_NO_TEXT;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_articulated_part, extra_callback_info1){
    1: return item_EH1000_series;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_default_front_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_default_front;
    1: return spriteset_EH1000_series_default_front_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_default_back_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_default_back;
    1: return spriteset_EH1000_series_default_back_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_2cc_front_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_2cc_front;
    1: return spriteset_EH1000_series_2cc_front_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_2cc_back_graphic, train_is_driving_backwards){
    0: return spriteset_EH1000_series_2cc_back;
    1: return spriteset_EH1000_series_2cc_back_rev;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic_front, cargo_subtype/2){
    0: return sw_EH1000_series_default_front_graphic;
    1: return sw_EH1000_series_2cc_front_graphic;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic_back, cargo_subtype/2){
    0: return sw_EH1000_series_default_back_graphic;
    1: return sw_EH1000_series_2cc_back_graphic;
}
switch(FEAT_TRAINS, SELF, sw_EH1000_series_graphic, position_in_articulated_veh%2){
    0: return sw_EH1000_series_graphic_front;
    1: return sw_EH1000_series_graphic_back;
}
item(FEAT_TRAINS, item_EH1000_series){
    property {
        name: string(STR_NAME_EH1000_TRAINS);
        track_type: TR_1067_AC_DC;
        climates_available: ALL_CLIMATES;
        introduction_date: date(2020,01,01);
        model_life: 45;
        vehicle_life: 50;
        reliability_decay: 25;
        cargo_allow_refit: [PASS];
        refit_cost: 0;
        dual_headed: 0;
        cargo_capacity: 1;
        air_drag_coefficient: 0;
        tractive_effort_coefficient: 0.3;
        power: 5000 kW;
        weight: 160 ton;
        ai_special_flag: AI_FLAG_PASSENGER;
        engine_class: ENGINE_CLASS_ELECTRIC;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        cost_factor: 111;
        running_cost_factor: 220;
        running_cost_base: RUNNING_COST_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 4, DISABLE_WAGON_POWER);
        length: 8;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
    }
    graphics {
        additional_text:
            string(STR_TRAIN_DESC,
            string(STR_NARROWGAUGE),
            string(STR_DENKI, string(STR_AC_DC_2_HZ, 20, 50, 60, 1500)),
            string(STR_USE, string(STR_CONCAT_2_COMMA,string(STR_HEAVY),string(STR_CONCAT_2_COMMA,string(STR_LONG),string(STR_HIGH_SPEED)))),
            string(STR_OPERATOR,string(STR_JR,string(STR_VIRTUAL, string(STR_JR_FREIGFT)))),
            string(STR_LIVERIES,string(LV_VARIOUS)),
            string(STR_EH1000_CONCEPT));
        speed: sw_EH1000_series_speed;
        articulated_part: sw_EH1000_series_articulated_part;
        cargo_capacity: return 0;
        cargo_subtype_text: sw_EF1000_series_cargo_subtype_text;
        purchase: spriteset_EH1000_series_purchase;
        default: sw_EH1000_series_graphic;
    }
}//80
spriteset(spriteset_80_series_default, "gfx/80/80_series.png"){tmpl_32_train_main(0,1)}

item(FEAT_TRAINS, item_80_series){
    property {
        name: string(STR_NAME_80_SERIES);
        climates_available: ALL_CLIMATES;
        introduction_date: date(2020,01,01);
        track_type: [TR_1067_NE];
        sprite_id: SPRITE_ID_NEW_TRAIN;
        misc_flags: bitmask(TRAIN_FLAG_TILT,TRAIN_FLAG_AUTOREFIT,TRAIN_FLAG_2CC);
        refit_cost: 0;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        ai_special_flag: AI_FLAG_PASSENGER;
        ai_engine_rank: 0;
        vehicle_life: 60;
        loading_speed: 0;
        cost_factor: 64;
        running_cost_factor: 6;
        reliability_decay: 20;
        power: 0 kW;
        cargo_capacity: 100;
        cargo_age_period: 185;
        weight: 28 ton;
        tractive_effort_coefficient: 0;
        air_drag_coefficient: 0.07;
        reliability_decay: 20;
        running_cost_base: RUNNING_COST_STEAM;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        speed: 160;
        purchase: spriteset_mucar_purchase;
        default: spriteset_80_series_default;
    }
}//sort
sort(FEAT_TRAINS, [
    item_mucar,
    item_123_series,
    item_521_series,
    item_600_series,
    item_2000_series,
    item_N2000_series,
    item_EH1000_series,
    item_80_series
]);
