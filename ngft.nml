grf {
	grfid: "NGFT";
	name: string(STR_NGFT_NAME);
	desc: string(STR_NGFT_DESC);
	version: 131;
	min_compatible_version: 0;
    url: string(STR_NGFT_URL);
    param 0 {
        param_purchase_cost {
            type: int;
            name: string(STR_NGFT_PURCHASE_COST_NAME);
            desc: string(STR_NGFT_PURCHASE_COST_DESC);
            min_value: 0;
            max_value: 3;
            def_value: 2;
            names: {
                0: string(STR_NGFT_COST_VERY_LOW);
                1: string(STR_NGFT_COST_LOW);
                2: string(STR_NGFT_COST_NOMAL);
                3: string(STR_NGFT_COST_HIGH);
            };
        }
    }
    param 1 {
        param_running_cost {
            type: int;
            name: string(STR_NGFT_RUNNING_COST_NAME);
            desc: string(STR_NGFT_RUNNING_COST_DESC);
            min_value: 0;
            max_value: 3;
            def_value: 2;
            names: {
                0: string(STR_NGFT_COST_VERY_LOW);
                1: string(STR_NGFT_COST_LOW);
                2: string(STR_NGFT_COST_NOMAL);
                3: string(STR_NGFT_COST_HIGH);
            };
        }
    }
    param 2 {
        param_loading_speed {
            type: int;
            name: string(STR_NGFT_LOADING_SPEED_NAME);
            desc: string(STR_NGFT_LOADING_SPEED_DESC);
            min_value: 0;
            max_value: 3;
            def_value: 2;
            names: {
                0: string(STR_NGFT_LOADING_SPEED_VERY_SLOW);
                1: string(STR_NGFT_LOADING_SPEED_SLOW);
                2: string(STR_NGFT_LOADING_SPEED_NOMAL);
                3: string(STR_NGFT_LOADING_SPEED_FAST);
            };
        }
    }
    param 3 {
        param_cargo_capacity {
            type: int;
            name: string(STR_NGFT_CARGO_CAPACITY_NAME);
            desc: string(STR_NGFT_CARGO_CAPACITY_DESC);
            min_value: 0;
            max_value: 4;
            def_value: 2;
            names: {
                0: string(STR_NGFT_CARGO_CAPACITY_quarter);
                1: string(STR_NGFT_CARGO_CAPACITY_half);
                2: string(STR_NGFT_CARGO_CAPACITY_default);
                3: string(STR_NGFT_CARGO_CAPACITY_X2);
                4: string(STR_NGFT_CARGO_CAPACITY_X4);
            };
        }
    }
    param 4 {
        param_high_speed {
            type: bool;
            name: string(STR_NGFT_HGIH_SPEED_NAME);
            desc: string(STR_NGFT_HGIH_SPEED_DESC);
            def_value: 0;
            bit: 0;
        }
    }
    // param 5 { 
    //     param_rail_cost {
    //         type: int;
    //         name: string(STR_NGFT_RAIL_COST_NAME);
    //         desc: string(STR_NGFT_RAIL_COST_DESC);
    //         min_value: 0;
    //         max_value: 3;
    //         def_value: 2;
    //         names: {
    //             0: string(STR_NGFT_COST_VERY_LOW);
    //             1: string(STR_NGFT_COST_LOW);
    //             2: string(STR_NGFT_COST_NOMAL);
    //             3: string(STR_NGFT_COST_HIGH);
    //         };
    //     }
    // }
}//tables
cargotable {
    //DEFAULT
    PASS, COAL, MAIL, OIL_, LVST, GOOD, GRAI, WOOD, IORE, STEL, VALU, PAPR, WHEA, FOOD, GOLD, RUBR, FRUT, MAIZ, CORE, WATR, DIAM, 
	//TOYLAND
	SUGR, TOYS, BATT, SWET, TOFF, COLA, CTCD, BUBL, PLST, FZDR, 
	//ECS
	AORE, BRCK, BDMT, CERA, CERE, CMNT, DYES, FERT, FICR, FISH, GLAS, LIME, OLSD, PETR, PLAS, POTA, RFPR, SAND, SULP, TOUR, VEHI, WDPR, WOOL, 
	//FIRS3, XIS
	METL, BEER, CLAY, COPR, ENSP, FMSP, GRVL, MILK, MNSP, PHOS, RCYC, SCMT, SGBT, SGCN, JAVA, CASS, NUTS, 
	EOIL, ACID, CHLO, ZINC, IRON, SASH, SALT, QLME, SLAG, MNO2, NITR, COKE, BEAN, PORE, PEAT, BOOM, KAOL, VPTS, VBOD, POWR, PIPE, 
	//FIRS 4
	CBLK, CSTI, CTAR, FECR, TYRE, COAT, LYE_, NH3_, O2__, SOAP, STAL, STCB, STSE, STSH, STST, STWR, VENG, 
	C2H4, HYAC, MEOH, NAPH, PHAC, C3H6, SUAC, TEXT, TIN_, TINP, UREA, 
	//AXIS
	ALO_, ALUM, COCO, H2__, NHNO, PPAR, ENUM, ACET, BIOM, RAMT,
	//FIRS 5
	CCPR, CRAN, FOCA, HWAR, LFEQ, N7__, PPWK, PUMP, RBAR, STBR, STPP, STTP, SWRP, TYCO, WELD, 
	//OTIS
	FRVG, URAN, BAKE, CHSE, ELTR, FUEL, FURN, MEAT, MPTS, NKOR, OTI1, OTI2, OYST, PCL_, SEED, SESP, TWOD, TATO, 
	//ITI, IotC
	WDCH, SCPR, WSTE, OILI, OILD, CIGR, TBCO, COBL, NICK, MOLS, 
	//MISC
	NUKF, NUKW, NWST, YETI, YETY
}
railtypetable {
    TR_1067_NE: [NAAN, RAIL], //Non-Electrified
    TR_1067_DC: [NAAD, NAAE, NABE, ELNG, ELRL],
    TR_1067_AC: [NAAA, NAAE, NABE, ELNG, ELRL],
    TR_1067_AC_DC: [NAAE, NABE, ELNG, ELRL],
    TR_1372_DC: [sAAD, sAAE, SAAD, SAAE, ELRL],
    TR_1435_NE: [SAAN, RAIL],
    TR_1435_DC: [SAAD, ELRL],
    TR_1435_AC: [SAAA, ELRL],
    TR_1435_AC_DC: [SAAE, ELRL],
    TR_1435_M: [SAA3, SAB3, "3RDR", MTRO, ELRL],
    TR_1435_LINEAR: [SAAI, ELRL],
    TR_RUBBER: [rAA3,rAAE, ELRL],
    TR_UNIVERSAL: [_AAE, NAAN, NAAE, NABE, sAAD, SAAD, SAAN, RAIL], //for mu cars
}//parameters

//loading speed
if(param_loading_speed == 0){
    param_loading_1D = 5; // 1 door
	param_loading_2D = 10; // 2 doors
	param_loading_3D = 20; // 3 doors
	param_loading_4D = 40; // 4 doors
	param_loading_5D = 45; // 5 doors
	param_loading_6D = 55; // 6 doors
}
if(param_loading_speed == 1){
    param_loading_1D = 10; // 1 door
	param_loading_2D = 20; // 2 doors
	param_loading_3D = 30; // 3 doors
	param_loading_4D = 50; // 4 doors
	param_loading_5D = 55; // 5 doors
	param_loading_6D = 65; // 6 doors
}
if(param_loading_speed == 2){
    param_loading_1D = 20; // 1 door
	param_loading_2D = 30; // 2 doors
	param_loading_3D = 40; // 3 doors
	param_loading_4D = 60; // 4 doors
	param_loading_5D = 65; // 5 doors
	param_loading_6D = 75; // 6 doors
}
if(param_loading_speed >= 3){
    param_loading_1D = 30; // 1 door
	param_loading_2D = 40; // 2 doors
	param_loading_3D = 50; // 3 doors
	param_loading_4D = 80; // 4 doors
	param_loading_5D = 85; // 5 doors
	param_loading_6D = 95; // 6 doors
}
//cargo capacity
if(param_cargo_capacity == 0){
    param_cargo_capacity_commuter = 40;
    param_cargo_capacity_regional = 35;
    param_cargo_capacity_local = 30;
    param_cargo_capacity_general = 45;
    param_cargo_capacity_express = 15;
}
if(param_cargo_capacity == 1){
    param_cargo_capacity_commuter = 80;
    param_cargo_capacity_regional = 70;
    param_cargo_capacity_local = 60;
    param_cargo_capacity_general = 90;
    param_cargo_capacity_express = 30;
}
if(param_cargo_capacity == 2){
    param_cargo_capacity_commuter = 160;
    param_cargo_capacity_regional = 170;
    param_cargo_capacity_local = 120;
    param_cargo_capacity_general = 155;
    param_cargo_capacity_express = 60;
}
if(param_cargo_capacity == 3){
    param_cargo_capacity_commuter = 320;
    param_cargo_capacity_regional = 340;
    param_cargo_capacity_local = 240;
    param_cargo_capacity_general = 310;
    param_cargo_capacity_express = 120;
}
if(param_cargo_capacity >= 4){
    param_cargo_capacity_commuter =  640;
    param_cargo_capacity_regional = 680;
    param_cargo_capacity_local = 480;
    param_cargo_capacity_general = 620;
    param_cargo_capacity_express = 240;
}
//speed
if(param_high_speed == 0){
    param_speed_120_to_160 = 120;
    param_speed_130_to_160 = 130;
    param_speed_150_to_200 = 150;
    param_speed_160_to_200 = 160;
}
if(param_high_speed == 1){
    param_speed_120_to_160 = 160;
    param_speed_130_to_160 = 160;
    param_speed_150_to_200 = 199;
    param_speed_160_to_200 = 199;
}
// traininfo offset
traininfo_y_offset = 2;
train_width_32_px = 1;//base cost
basecost {
	PR_BUILD_VEHICLE_TRAIN : param_purchase_cost -2;
	PR_BUILD_VEHICLE_WAGON: param_purchase_cost +2;
	PR_RUNNING_TRAIN_STEAM: param_running_cost +1;
	PR_RUNNING_TRAIN_DIESEL: param_running_cost;
	PR_RUNNING_TRAIN_ELECTRIC: param_running_cost;

	//PR_BUILD_RAIL	: param_rail_cost+1;
}//template
template tmpl_32_train(x, y){
    // arguments x, y: coordinates of top-left corner of first sprite
    [x,      y,  8, 24,  -3, -12] //xpos ypos xsize ysize xoff yoff
    [x +  9, y, 22, 20, -14, -12]
    [x + 32, y, 32, 16, -16, -12]
    [x + 65, y, 22, 20,  -6, -12]
}
template tmpl_32_train_4_views(num){
    // argument num: Index in the graphics file, assuming vertical ordering of vehicles
    tmpl_32_train(1, 1 + 32 * num)
}
template tmpl_32_train_8_views(num, reversed){
    // argument num: Index in the graphics file, assuming vertical ordering of vehicles
    // argument reversed: Reverse visible orientation of vehicle, if set to 1
    tmpl_32_train(reversed ? 89 : 1, 1 + 32 * num)
    tmpl_32_train(reversed ? 1 : 89, 1 + 32 * num)
}
template tmpl_32_train_single(num, xsize, ysize, xoff, yoff) { 
    [1, 1 + 32 * num, xsize, ysize, xoff, yoff]
}
template tmpl_32_train_basic(x, y){
    //[left_x, upper_y, width, height, offset_x, offset_y]
    [x    , y,  8, 24,  -3, -12]
    [x+9  , y, 22, 20, -14, -12]
    [x+32 , y, 32, 16, -16, -12]
    [x+65 , y, 22, 20,  -6, -12]
    [x+88 , y,  8, 24,  -3, -12]
    [x+97 , y, 22, 20, -14, -12]
    [x+120, y, 32, 16, -16, -12]
    [x+153, y, 22, 20,  -6, -12]
}
template tmpl_32_train_main(x, y){
    //[left_x, upper_y, width, height, offset_x, offset_y]
    [x    , y,  8, 28,  -3, -15]
    [x+9  , y, 22, 21, -15, -12]
    [x+32 , y, 32, 16, -16, -12]
    [x+65 , y, 22, 21,  -3, -12]
    [x+88 , y,  8, 28,  -3, -15]
    [x+97 , y, 22, 21, -16, -12]
    [x+120, y, 32, 16, -16, -12]
    [x+153, y, 22, 21,  -4, -12]
}
template tmpl_32_train_main_harf(x, y, num1, num2){
    //[left_x, upper_y, width, height, offset_x, offset_y]
    [x    , y,  8, 28,  -3, -14-num1]
    [x+9  , y, 22, 21, -15-num2, -12]
    [x+32 , y, 32, 16, -16, -12]
    [x+65 , y, 22, 21,  -3-num2, -12]
}
template tmpl_32_train_main_reversing(x, y, revers){
    tmpl_32_train_main_harf(revers ? x+88 : x, y, revers ? 1 : 0, revers ? 1 : 0)
    tmpl_32_train_main_harf(revers ? x : x+88, y, revers ? 0 : 1, revers ? 0 : 1)
}
template tmpl_32_train_main_revers(x, y){
    tmpl_32_train_main_harf(x+88, y, 0, 1)
    tmpl_32_train_main_harf(x, y, 1, 0)
}
template tmpl_32_train_main_227and521(x, y){
    tmpl_32_train_main_harf(x, y, 1, 0)
    tmpl_32_train_main_harf(x+88, y, 0, 1)
}
template tmpl_purchase_single_head(x, y){
    [x, y, 74, 15, -26, -10]
}
template tmpl_purchase_dual_head(x, y){
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
    [x, y, 74, 15, -13, -10]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty.png"]
}
template tmpl_purchase_dual_head_32bpp(x, y){
    [1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
    [x, y, 74, 15, -13, -10]
	[1 , 1, 1, 1, 0, 0, "gfx/empty/empty_32bpp.png"]
}
