##grflangid 0x01

#desc
STR_NGFT_NAME :Narrow Gauge Fast Train SET {VERSION}
STR_NGFT_DESC :Narrow Gauge Fast Train SET is a set of trains that can run over 200 km/h on 1067mm narrow guage. {}{RED}JP+ Track {BLACK}is required to run this newGRF. {}Code: Kimhostars {}Graphics: Kimjostars, raeun_cos, JP+(Asset used) {}Translation: irice7350

#parameters
STR_NGFT_PURCHASE_COST_NAME :Purchase cost
STR_NGFT_PURCHASE_COST_DESC :It is Purchase cost Defind
STR_NGFT_PURCHASE_COST_VERY_LOW :Very Low
STR_NGFT_PURCHASE_COST_LOW :Low
STR_NGFT_PURCHASE_COST_NOMAL :Nomal (Default)
STR_NGFT_PURCHASE_COST_HIGH :High
STR_NGFT_RUNNING_COST_NAME : Running Cost
STR_NGFT_RUNNING_COST_DESC : It is Running Cost Defind
STR_NGFT_RUNNING_COST_VERY_LOW :Very Low
STR_NGFT_RUNNING_COST_LOW :Low
STR_NGFT_RUNNING_COST_NOMAL :Nomal (Default)
STR_NGFT_RUNNING_COST_HIGH :High
STR_NGFT_LOADING_SPEED_NAME :Loading Speed
STR_NGFT_LOADING_SPEED_DESC :It is Loading Speed Defind
STR_NGFT_LOADING_SPEED_VERY_SLOW :Very Slow
STR_NGFT_LOADING_SPEED_SLOW :Slow
STR_NGFT_LOADING_SPEED_NOMAL :Nomal (Default)
STR_NGFT_LOADING_SPEED_FAST :Fast
STR_NGFT_CARGO_CAPACITY_NAME :Transport volume
STR_NGFT_CARGO_CAPACITY_DESC :Set the transport volume.{}If it is "x1", it is equal to the actual transport volume.
STR_NGFT_CARGO_CAPACITY_quarter :x1/4
STR_NGFT_CARGO_CAPACITY_half :x1/2
STR_NGFT_CARGO_CAPACITY_default :x1 (Default)
STR_NGFT_CARGO_CAPACITY_X2 :x2
STR_NGFT_CARGO_CAPACITY_X4 :x4
STR_NGFT_HGIH_SPEED_NAME :Improvement of train speed limits
STR_NGFT_HGIH_SPEED_DESC :Enabling this setting increases the train speed limit.{}default value is disabled.

