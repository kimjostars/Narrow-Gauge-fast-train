spriteset(spriteset_2000_series_1_2_0, "gfx/mucar/mucar.png") {tmpl_32_train_basic(0, 0)}
alternative_sprites(spriteset_2000_series_1_2_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/2000/2000_1_series.png"){tmpl_32_train_main(0, 1)}
