grf {
	grfid: "NGFT";
	name: string(STR_NGFT_NAME);
	desc: string(STR_NGFT_DESC);
	version: 30;
	min_compatible_version: 0;
    param 0 {
        param_purchase_cost {
            type: int;
            name: string(STR_NGFT_PURCHASE_COST_NAME);
            desc: string(STR_NGFT_PURCHASE_COST_DESC);
            min_value: 0;
            max_value: 3;
            def_value: 2;
            names: {
                0: string(STR_NGFT_PURCHASE_COST_VERY_LOW);
                1: string(STR_NGFT_PURCHASE_COST_LOW);
                2: string(STR_NGFT_PURCHASE_COST_NOMAL);
                3: string(STR_NGFT_PURCHASE_COST_HIGH);
            };
        }
    }
    param 1 {
        param_running_cost {
            type: int;
            name: string(STR_NGFT_RUNNING_COST_NAME);
            desc: string(STR_NGFT_RUNNING_COST_DESC);
            min_value: 0;
            max_value: 3;
            def_value: 2;
            names: {
                0: string(STR_NGFT_RUNNING_COST_VERY_LOW);
                1: string(STR_NGFT_RUNNING_COST_LOW);
                2: string(STR_NGFT_RUNNING_COST_NOMAL);
                3: string(STR_NGFT_RUNNING_COST_HIGH);
            };
        }
    }
}
