#include "narrow_hgh_speed_AC_graphics.pnml"

item(FEAT_RAILTYPES, track_narrow_high_speed_ac, 01) {
    property {
        label: "NCEA";
        introduction_date: date(2020, 1, 1);               
        name: string(STR_NGFT_HIGH_SPEED_AC);
        menu_text: string(STR_NGFT_HIGH_SPEED_AC);
        toolbar_caption: string(STR_NGFT_HIGH_SPEED_AC);
        build_window_caption: string(STR_NGFT_HIGH_SPEED_AC);
        new_engine_text: string(STR_NGFT_HIGH_SPEED_AC);
        autoreplace_text: string(STR_NGFT_HIGH_SPEED_AC);

        station_graphics: RAILTYPE_STATION_NORMAL;
        acceleration_model: ACC_MODEL_RAIL;
        speed_limit: 220 km/h;
        construction_cost: 12;
        maintenance_cost: 11;
        sort_order: 37;
        map_colour: 164;
        curve_speed_multiplier: 2;

        railtype_flags: bitmask(RAILTYPE_FLAG_CATENARY, RAILTYPE_FLAG_PRECOMBINED);
        compatible_railtype_list: ["NAAN", "RAIL", "NAAD", "NAAA", "NAAE", "NABE", "ELNG", "ELRL", "RAIL"];
        introduces_railtype_list: ["NAAE", "NABE", "ELNG", "ELRL"];
        powered_railtype_list: ["NAAA", "NAAE", "NAAN", "NABE", "ELNG", "ELRL"];
    }
    graphics {
        gui: spriteset_track_gui;
    }
}